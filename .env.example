# Database connection
DATABASE_URL="file:./dev.db"

# Host Port to expose on your machine (e.g. 3050, 8080, 3001)
HOST_PORT=3050
PORT=3050

# Public App URL (used for OAuth redirects and webhooks)
NEXT_PUBLIC_APP_URL="http://localhost:3050"

# Employee Google OAuth Authentication & Security
ENABLE_AUTH="true" # Set to "false" to bypass login during offline dev
AUTH_SECRET="your_random_32_character_secret_here" # Random string for signing sessions
ALLOWED_EMAIL_DOMAINS="platcomco.com" # Restricts login to your Google Workspace domain
ALLOWED_USERS="" # Optional: specific allowed emails, e.g. "admin@company.com,user@gmail.com"

# Google Workspace OAuth Credentials (used for both Login and Gmail thread search)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# UniFi Talk PBX Webhook Security (optional secret token)
UNIFI_TALK_WEBHOOK_SECRET="talkcrm-secret-token"

# QuickBooks Online (Intuit Developer)
QBO_CLIENT_ID="your_intuit_client_id"
QBO_CLIENT_SECRET="your_intuit_client_secret"
QBO_ENVIRONMENT="sandbox" # or "production"
