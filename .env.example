# Database connection
DATABASE_URL="file:./dev.db"

# Host Port to expose on your machine (e.g. 3050, 8080, 3001)
HOST_PORT=3050
PORT=3050

# Public App URL (used for OAuth redirects and webhooks)
NEXT_PUBLIC_APP_URL="http://localhost:3050"

# Employee Google OAuth Authentication & Security
ENABLE_AUTH="true" # Set to "false" ONLY for local offline testing; never on a reachable server
# REQUIRED: 32+ random characters; there is no default, and login is refused without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
# Google Workspace domain(s) allowed to log in. If this AND ALLOWED_USERS are empty, nobody can log in.
ALLOWED_EMAIL_DOMAINS="platinumcom.co"
ALLOWED_USERS="" # Optional: specific Google-verified emails, e.g. "contractor@gmail.com"

# Google Workspace OAuth Credentials (used for both Login and Gmail thread search)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# UniFi Talk PBX webhook secret. REQUIRED: the webhook rejects every call without it.
# Set the same value in UniFi Talk: Authentication "Custom Header", header x-unifi-secret.
UNIFI_TALK_WEBHOOK_SECRET=""

# QuickBooks Online (Intuit Developer)
QBO_CLIENT_ID="your_intuit_client_id"
QBO_CLIENT_SECRET="your_intuit_client_secret"
QBO_ENVIRONMENT="sandbox" # or "production"

# Show the "Reset / Seed Demo Data" button (local testing only; never with real QuickBooks data)
ENABLE_DEMO_DATA="false"
