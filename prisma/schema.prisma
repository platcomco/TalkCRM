generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Customer {
  id               String         @id @default(cuid())
  name             String
  companyName      String?
  primaryPhone     String?
  mobilePhone      String?
  normalizedPhones String         @default("") // comma-separated digits for matching
  email            String?
  billingAddress   String?
  qboId            String?        @unique
  qboBalance       Float?         @default(0.0)
  qboNotes         String?        // QuickBooks customer "Notes" field
  customerType     String?        // QuickBooks "Client type" (DIRECTV vertical, e.g. BAR)
  parentName       String?        // Parent client for QuickBooks sub-clients
  accountNumber    String?        // DIRECTV account number, extracted from notes / company name
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  calls            CallLog[]
  invoices         InvoiceCache[]
  notes            Note[]
  chatThreads      ChatThread[]

  @@index([email])
}

model CallLog {
  id             String    @id @default(cuid())
  callId         String?   @unique
  fromNumber     String
  normalizedFrom String
  toExtension    String?
  direction      String    @default("inbound") // inbound, outbound
  status         String    @default("ringing") // ringing, answered, completed, missed
  duration       Int       @default(0) // seconds
  timestamp      DateTime  @default(now())
  answeredAt     DateTime? // UniFi Talk sends no duration; talk time = completed - answeredAt

  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  notes          Note[]

  @@index([normalizedFrom])
  @@index([timestamp])
}

model Note {
  id         String    @id @default(cuid())
  content    String
  author     String    @default("Agent")
  createdAt  DateTime  @default(now())

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  callLogId  String?
  callLog    CallLog?  @relation(fields: [callLogId], references: [id], onDelete: SetNull)

  @@index([customerId])
}

model InvoiceCache {
  id           String    @id @default(cuid())
  qboInvoiceId String    @unique
  docNumber    String
  totalAmount  Float
  balance      Float
  dueDate      String?
  txnDate      String?
  status       String    @default("Open") // Paid, Open, Overdue
  
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  updatedAt    DateTime  @updatedAt

  @@index([customerId])
}

model Integration {
  id             String    @id @default(cuid())
  provider       String    @unique // quickbooks
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  realmId        String?   // QBO Company/Realm ID
  metadata       String?   // JSON object for additional flags
  lastSyncedAt   DateTime? // when the last successful sync finished
  updatedAt      DateTime  @updatedAt
}

// Each staff member's own Google authorization (Gmail lookup and Chat reading), keyed by
// their sign-in email
model GoogleAccount {
  email          String    @id
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  scopes         String    @default("") // space-separated scopes Google granted
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// A Google Chat space whose threads hold per-customer site-visit notes
model ChatSpace {
  name         String       @id // spaces/AAAA...
  displayName  String
  syncAsEmail  String       // whose Google connection reads the space (must be a member)
  lastSyncedAt DateTime?
  lastError    String?
  createdAt    DateTime     @default(now())

  threads      ChatThread[]
}

model ChatThread {
  name          String        @id // spaces/AAAA/threads/BBBB
  spaceName     String
  space         ChatSpace     @relation(fields: [spaceName], references: [name], onDelete: Cascade)
  title         String        // text of the thread's first message
  lastMessageAt DateTime
  messageCount  Int           @default(0)

  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  linkSource    String?       // null = not decided yet, "auto" = matched by sync, "manual" = set by a person (never auto-changed)

  messages      ChatMessage[]

  @@index([customerId])
  @@index([spaceName])
}

model ChatMessage {
  name            String     @id // spaces/AAAA/messages/CCCC
  threadName      String
  thread          ChatThread @relation(fields: [threadName], references: [name], onDelete: Cascade)
  text            String
  senderName      String?
  createTime      DateTime
  attachmentCount Int        @default(0)

  @@index([threadName, createTime])
}
